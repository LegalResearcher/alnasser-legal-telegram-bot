# انسخ هذا الملف إلى .env محليًا ثم أضف القيم الحقيقية في بيئة التشغيل فقط.
# لا ترفع ملف .env أو أي مفتاح فعلي إلى GitHub.

NODE_ENV=development
PORT=

# قاعدة البيانات وDrizzle
DATABASE_URL=

# أمان الجلسات وManus OAuth
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# بوت تيليغرام
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Supabase للتحقق من زيارات Telegram وطبقة تخزين البوت الجديدة
SUPABASE_URL=https://nhrlwemvkvgmtzoiwcym.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# فعّل في نسخة Vercel الجديدة بعد إنشاء جداول bot_* فقط.
BOT_STORAGE_MODE=supabase
# لا تُفعّل مزامنة الامتحانات الدورية؛ الاستيراد يتم كعملية Snapshot صريحة.
ENABLE_SUPABASE_EXAM_SYNC_JOB=false

# خدمات Manus المدمجة
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# اختياري: استيراد مصادر وعمليات إدارية محلية
ROOT_FOLDER_ID=
ROOT_FOLDER_NAME=
COLLECTION=
DRY_RUN=
TITLE_REPORT=

# اختياري: تكامل OpenAI عند تفعيله
OPENAI_API_BASE=
OPENAI_API_KEY=
